# ---- ServiceNow ----------------------------------------------------------
# live = your instance (API) | snapshot = CSV export of your instance | mock = invented sample data
SERVICENOW_MODE=live
SERVICENOW_INSTANCE_URL=https://dev443878.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=paste-your-instance-password-here
SERVICENOW_TIMEOUT=30
# basic = username + password above; oauth = client credentials (needed when the instance blocks Basic Auth)
SERVICENOW_AUTH=basic
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# ---- Shifts (for the start-of-shift briefing)
SHIFTS=Day=07-15,Evening=15-23,Night=23-07
SHIFT_TZ=America/Chicago

# ---- Snapshot mode (SERVICENOW_MODE=snapshot): real records exported as CSV into ./snapshot
# SNAPSHOT_DIR=snapshot
# SNAPSHOT_REBASE=true

# ---- LLM (provider:model) --------------------------------------------------
# openai:gpt-4o-mini | azure_openai:<deployment> | anthropic:claude-sonnet-4-5 | google_genai:gemini-2.5-flash | ollama:llama3.1
LLM_MODEL=openai:gpt-4o-mini
LLM_TEMPERATURE=0

OPENAI_API_KEY=
# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=2024-10-21
# Anthropic
ANTHROPIC_API_KEY=

# ---- AIOps anomaly agent (see docs/ANOMALY_DETECTION.md) -------------------
# Your predictive model (REST contract in the doc)
AIOPS_MODEL_URL=
AIOPS_MODEL_TOKEN=
AIOPS_MODEL_THRESHOLD=0.6
# Dynatrace (Api-Token with problems.read, metrics.read)
AIOPS_DYNATRACE_URL=
AIOPS_DYNATRACE_TOKEN=
# AppDynamics (API client token; comma-separated application names)
AIOPS_APPD_URL=
AIOPS_APPD_TOKEN=
AIOPS_APPD_APPS=
# Splunk (management port 8089, bearer token)
AIOPS_SPLUNK_URL=
AIOPS_SPLUNK_TOKEN=
AIOPS_SPLUNK_BASELINE=-24h
# Transaction tracking (docs/TRANSACTION_TRACKING.md)
AIOPS_TXN_LOOKBACK=24h
AIOPS_APPD_TXN_COLLECTOR=
AIOPS_DYNATRACE_GRAIL_URL=
AIOPS_DYNATRACE_PLATFORM_TOKEN=
AIOPS_DT_TXN_ATTR=txn.id
AIOPS_JAEGER_URL=
AIOPS_TEMPO_URL=

# Reliability / change guard (docs/SRE.md): SLOs and change policy live in aiops_config.json
AIOPS_SLO_SERIES=false
AIOPS_PEAK_HOURS=08-18

# ---- Safety ------------------------------------------------------------------
# true = you confirm every create / update / note / resolve
REQUIRE_APPROVAL=true

# ---- Optional: LangSmith tracing (see each tool call in a UI) ---------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=servicenow-incident-agent

# --- ALM bridge (create stories / defects from incidents, anomalies, RCA actions) ---
AIOPS_ALM_TARGET=
AIOPS_SYNTHOGEN_MCP_URL=
AIOPS_SYNTHOGEN_TOKEN=
AIOPS_SYNTHOGEN_CREATE_TOOL=create_work_item
AIOPS_SYNTHOGEN_SYSTEM=jira
AIOPS_JIRA_URL=
AIOPS_JIRA_TOKEN=
AIOPS_JIRA_EMAIL=
AIOPS_JIRA_PROJECT=
AIOPS_RALLY_APIKEY=
AIOPS_RALLY_PROJECT=
AIOPS_RALLY_URL=https://rally1.rallydev.com
AIOPS_ADO_ORG_URL=
AIOPS_ADO_PROJECT=
AIOPS_ADO_PAT=
